@prefix other: <https://example.test/other#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The ontology's IRI is the namespace without its `#`, as owl's and dcat's are.
<https://example.test/other> a owl:Ontology .

other:Elsewhere a rdfs:Class ; rdfs:comment "A class in the second namespace." .
other:yield a rdf:Property .
