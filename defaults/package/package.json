{
  "name": "${package_name}",
  "description": "",
  "author": {
    "name": "",
    "email": "",
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "version": "1.0.0",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "//types": "Correct as written, do not 'fix' it: typesVersions below is applied to the types field too, so \"index.d.ts\" resolves to lib/esm/index.d.ts. Writing that literal path applies the mapping twice (lib/esm/lib/esm/index.d.ts) and breaks node10 resolution. Verify with ts.resolveModuleName under node10 AND bundler, not by looking for the file on disk.",
  "types": "index.d.ts",
  "license": "ISC",
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "linked dev",
    "build": "linked build"
  },
  "keywords": [
    "linked",
    "linked data",
    "semantic web",
    "web3"
  ],
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/core": "^2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@_linked/cli": "^1.45.0",
    "typescript": "^5.7.3"
  }
}
